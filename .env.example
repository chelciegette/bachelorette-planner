# Copy this file to `.env.local` (git ignores it) and fill in the two values from
# Supabase dashboard → the "Connect" button (project URL + *publishable* key; the key is
# also under Settings → API Keys).
#
# Leave both empty to keep running in demo mode — answers are then saved in this
# browser only. See README → "Go live" for the full setup.
#
# The publishable key is meant to be public. NEVER paste a `service_role` / secret key here:
# anything prefixed VITE_ is shipped to every visitor's browser.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
